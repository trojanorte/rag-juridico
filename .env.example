# Required only for administrative pages.
LEXRAG_ADMIN_PASSWORD=
OPENAI_API_KEY=

# Private HTTPS ZIP containing CURRENT and versions/<version>/{faiss.index,metadata.jsonl,manifest.json}.
# Keep the URL/token and archive outside the public repository.
LEXRAG_INDEX_BUNDLE_URL=
LEXRAG_INDEX_BUNDLE_SHA256=
LEXRAG_INDEX_BUNDLE_TOKEN=

# Optional
DATABASE_URL=
LEXRAG_MODEL=gpt-4.1-mini
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.82
MAX_CONTEXT_TOKENS=1200
MAX_CHUNK_TOKENS=350
